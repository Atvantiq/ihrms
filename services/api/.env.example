# Copy to .env and fill in. NEVER commit .env.
# Dev - Employee Database (shared with ONAQT). IPv4 networks must use the
# session pooler — the direct db.*.supabase.co host is IPv6-only.
# APP connection — non-privileged role so RLS (tenant isolation) is enforced.
DATABASE_URL=postgresql://ihrms_app.emckffbgrxwifwymhikv:APP_ROLE_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# MIGRATIONS connection — owner/superuser (DDL + bypasses RLS). Use for `alembic`, not the app.
# MIGRATIONS_DATABASE_URL=postgresql://postgres.emckffbgrxwifwymhikv:OWNER_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Auth (shared login with ONAQT)
SUPABASE_URL=https://emckffbgrxwifwymhikv.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

ENVIRONMENT=dev
TENANT_ID=atvantiq

# DEV ONLY — enables POST /auth/dev-login (password-free HR sign-in for local exploration).
# Leave false/unset everywhere except local dev.
DEV_LOGIN_ENABLED=true
